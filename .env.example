# PayPal Developer (developer.paypal.com) Sandbox credentials.
# A regular paypal.com login does NOT give Client ID / Secret.
# Fill this file privately (05-rahasia/ or app root). NEVER commit it.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# LLM for appeal letter generation — NVIDIA NIM (OpenAI-compatible).
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

APP_BASE_URL=http://localhost:5000
